{
  "name": "painel-protheus-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Protótipo navegável de gerenciamento Windows e Protheus com operações simuladas",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
